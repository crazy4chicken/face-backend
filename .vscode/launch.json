{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: 启动后端 (调试)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host", "127.0.0.1",
                "--port", "18000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python: 运行冒烟测试",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/smoke_test.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
