{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "启动后端 (后台)",
            "type": "shell",
            "command": "python -m uvicorn app.main:app --host 127.0.0.1 --port 18000",
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "运行冒烟测试",
            "type": "shell",
            "command": "python smoke_test.py",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "安装依赖",
            "type": "shell",
            "command": "pip install -r requirements.txt",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
